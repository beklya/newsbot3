# ============================================================
# newsbot3 (frozen news-sentiment bot) — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# All services resolve .env from the project root.
# ============================================================

# --- Telegram (Receiver). Get API_ID / API_HASH at https://my.telegram.org ---
TG_API_ID=0000000
TG_API_HASH=your_api_hash_here
TG_PHONE=+70000000000

# --- Redis / Memurai (all services) ---
REDIS_URL=redis://localhost:6379

# --- Enricher LLM provider: "groq" or "deepinfra" ---
ENRICHER_PROVIDER=deepinfra
# Groq API key
GROQ_API_KEYS=your_groq_key_here
# DeepInfra (OpenAI-compatible API)
DEEPINFRA_API_KEY=your_deepinfra_key_here

# --- Minute price CSVs (prices_<TICKER>.csv) for predictor and bridge ---
# Default: <project>/data/prices. The directory must exist or the services refuse to start.
# PRICES_DIR=./data/prices

# --- Optional overrides (defaults are fine) ---
# MODELS_DIR=./data/models/predictor/v1
# SESSION_PATH=./data/sessions/receiver.session
# BACKFILL_HOURS=0
# PROMPT_VERSION=1.0.0
# CONSUMER_NAME=enricher-1

# --- Optional outbound SOCKS5 proxy for Receiver (Telethon) and Enricher (LLM HTTP) ---
# PROXY_ENABLED=true
# PROXY_URL=socks5://USER:PASSWORD@HOST:PORT
